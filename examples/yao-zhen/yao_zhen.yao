  # 二至五爻：连自己带左右，共三爻翻转
  # 初爻与上爻只在边界内翻转两爻
  转 * 行 -> 合 n {
    1 => 变(本 ^ 0b000011, 1),
    6 => 变(本 ^ 0b110000, 0b100000),
    _ => 变(本 ^ (7 << (n - 2)), 1 << (n - 1))
  }

  起 未济
