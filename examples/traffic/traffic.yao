# 交通灯 · 一个真的跑在 C 里的控制器
#
# 6 位被拆成两个字段：
#   低 3 位 = 相位（0 南北绿 / 1 南北黄 / 2 全红 / 3 东西绿 / 4 东西黄）
#   高 3 位 = 剩余秒数
#
# 这是这门语言典型的样子：没有变量、没有计数器，
# 倒计时就存状态自己的高三位里。

机 交通灯 {
  事 秒
  事 行人

  态 南北绿 = 0 | (5 << 3)
  态 南北黄 = 1 | (2 << 3)
  态 全红   = 2 | (1 << 3)
  态 东西绿 = 3 | (5 << 3)
  态 东西黄 = 4 | (2 << 3)

  # 每一秒：先看倒计时。到 0 就换相位，否则减一。
  转 * 秒 -> 合 (本 >> 3) {
    0 => 合 (本 & 7) {
      0 => 变(1 | (2 << 3), 0),
      1 => 变(2 | (1 << 3), 0),
      2 => 变(3 | (5 << 3), 0),
      3 => 变(4 | (2 << 3), 0),
      _ => 变(0 | (5 << 3), 0)
    },
    _ => 变((本 & 7) | (((本 >> 3) - 1) << 3), 0)
  }

  # 行人按钮：只在南北绿时有效，提前转黄；其它相位忽略。
  转 * 行人 -> 合 (本 & 7) {
    0 => 变(1 | (2 << 3), 0),
    _ => 本
  }

  起 南北绿
}
