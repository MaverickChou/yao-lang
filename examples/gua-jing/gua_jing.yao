# 卦境 · 六十四卦地牢
#
# 房间 = 卦，移动 = 变爻。状态是 12 位的 `变`：
#   本 = 你现在在哪一间
#   动 = 你是从哪条爻走进来的（这一位记录了来路）
#   之 = 本 ^ 动 = 上一间房
#
# 由 tools/gen_gua_jing.py 生成，请勿手工编辑。

机 卦境 {
  事 行(位 n)
  事 错卦
  事 综卦
  事 互卦

  态 乾 = 乾
  态 坤 = 坤
  态 屯 = 屯
  态 蒙 = 蒙
  态 需 = 需
  态 讼 = 讼
  态 师 = 师
  态 比 = 比
  态 小畜 = 小畜
  态 履 = 履
  态 泰 = 泰
  态 否 = 否
  态 同人 = 同人
  态 大有 = 大有
  态 谦 = 谦
  态 豫 = 豫
  态 随 = 随
  态 蛊 = 蛊
  态 临 = 临
  态 观 = 观
  态 噬嗑 = 噬嗑
  态 贲 = 贲
  态 剥 = 剥
  态 复 = 复
  态 无妄 = 无妄
  态 大畜 = 大畜
  态 颐 = 颐
  态 大过 = 大过
  态 坎 = 坎
  态 离 = 离
  态 咸 = 咸
  态 恒 = 恒
  态 遯 = 遯
  态 大壮 = 大壮
  态 晋 = 晋
  态 明夷 = 明夷
  态 家人 = 家人
  态 睽 = 睽
  态 蹇 = 蹇
  态 解 = 解
  态 损 = 损
  态 益 = 益
  态 夬 = 夬
  态 姤 = 姤
  态 萃 = 萃
  态 升 = 升
  态 困 = 困
  态 井 = 井
  态 革 = 革
  态 鼎 = 鼎
  态 震 = 震
  态 艮 = 艮
  态 渐 = 渐
  态 归妹 = 归妹
  态 丰 = 丰
  态 旅 = 旅
  态 巽 = 巽
  态 兑 = 兑
  态 涣 = 涣
  态 节 = 节
  态 中孚 = 中孚
  态 小过 = 小过
  态 既济 = 既济
  态 未济 = 未济

  # 移动：翻转第 n 爻，并记下这一爻是来路
  转 * 行   -> 变(本 ^ (1 << (n - 1)), 1 << (n - 1))

  # 错：六爻全变，等价于对径点跳跃；动 = 111111 时 之 正好是来处
  转 * 错卦 -> 变(错(本), 0b111111)

  # 综：镜像世界，坐标反序，不算爻变
  转 * 综卦 -> 变(综(本), 0)

  # 互：密道，走进卦的内部结构
  转 * 互卦 -> 变(互(本), 0)

  起 未济
}
