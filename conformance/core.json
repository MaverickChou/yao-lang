{
  "spec_version": "0.1",
  "note": "一致性用例。任何实现必须全部通过才能自称兼容 爻 v0.1。expect 为数值，type 为期望类型。",
  "cases": [
    { "name": "乾 = 63", "expr": "数(乾)", "expect": 63, "type": "数" },
    { "name": "坤 = 0", "expr": "数(坤)", "expect": 0, "type": "数" },
    { "name": "既济 = 0b010101", "expr": "数(既济)", "expect": 21, "type": "数" },
    { "name": "未济 = 0b101010", "expr": "数(未济)", "expect": 42, "type": "数" },

    { "name": "既济之互卦为未济", "expr": "数(互(既济))", "expect": 42, "type": "数" },
    { "name": "泰之互卦为归妹", "expr": "数(互(泰))", "expect": 11, "type": "数" },
    { "name": "否之互卦为渐", "expr": "数(互(否))", "expect": 52, "type": "数" },
    { "name": "师之互卦为复", "expr": "数(互(师))", "expect": 1, "type": "数" },
    { "name": "谦之互卦为解", "expr": "数(互(谦))", "expect": 10, "type": "数" },

    { "name": "既济与未济互为错卦", "expr": "数(错(既济))", "expect": 42, "type": "数" },
    { "name": "泰与否互为错卦", "expr": "数(错(泰))", "expect": 56, "type": "数" },
    { "name": "泰与否互为综卦", "expr": "数(综(泰))", "expect": 56, "type": "数" },
    { "name": "损与益互为综卦", "expr": "数(综(损))", "expect": 49, "type": "数" },
    { "name": "屯与蒙互为综卦", "expr": "数(综(屯))", "expect": 34, "type": "数" },
    { "name": "随与蛊互为错综", "expr": "数(综(随))", "expect": 38, "type": "数" },
    { "name": "乾为自综", "expr": "数(综(乾))", "expect": 63, "type": "数" },

    { "name": "既济全当位", "expr": "当位(既济)", "expect": 6, "type": "数" },
    { "name": "未济全不当位", "expr": "当位(未济)", "expect": 0, "type": "数" },
    { "name": "泰当位 4", "expr": "当位(泰)", "expect": 4, "type": "数" },

    { "name": "先天序 = 卦值", "expr": "序(乾, 先天)", "expect": 63, "type": "数" },
    { "name": "文王序 乾 = 1", "expr": "序(乾, 文王)", "expect": 1, "type": "数" },
    { "name": "文王序 未济 = 64", "expr": "序(未济, 文王)", "expect": 64, "type": "数" },
    { "name": "文王序 既济 = 63", "expr": "序(既济, 文王)", "expect": 63, "type": "数" },

    { "name": "爻串 987789 的本卦", "expr": "数(本(987789))", "expect": 45, "type": "数" },
    { "name": "爻串 987789 的动爻", "expr": "数(动(987789))", "expect": 33, "type": "数" },
    { "name": "爻串 987789 的之卦", "expr": "数(之(987789))", "expect": 12, "type": "数" },
    { "name": "爻串 987789 有 2 爻动", "expr": "变数(987789)", "expect": 2, "type": "数" },
    { "name": "静卦 变数 为 0", "expr": "变数(既济)", "expect": 0, "type": "数" },
    { "name": "全动 变数 为 6", "expr": "变数(既济/111111)", "expect": 6, "type": "数" },

    { "name": "既济初爻为少阳", "expr": "爻(既济, 1)", "expect": 7, "type": "爻" },
    { "name": "否初爻为少阴", "expr": "爻(否, 1)", "expect": 8, "type": "爻" },
    { "name": "老阳变阴", "expr": "爻(既济/111111, 1)", "expect": 9, "type": "爻" },
    { "name": "老阴变阳", "expr": "爻(既济/111111, 2)", "expect": 6, "type": "爻" },

    { "name": "变构造保持不变式", "expr": "数(之(变(既济, 0b100001)))", "expect": 52, "type": "数" },
    { "name": "错为对合", "expr": "数(错(错(暌)))", "expect": 43, "type": "数" },
    { "name": "卦 由 数 构造", "expr": "数(卦(21))", "expect": 21, "type": "数" }
  ]
}
