# 换行符与文本属性
* text=auto

# Windows 启动器必须是 CRLF，否则 cmd.exe 解析会吃掉字符
*.cmd text eol=crlf
*.ps1 text eol=crlf

# 其余一律 LF
*.js   text eol=lf
*.mjs  text eol=lf
*.json text eol=lf
*.md   text eol=lf
*.html text eol=lf
*.css  text eol=lf
*.py   text eol=lf
*.yao  text eol=lf
*.c    text eol=lf
*.yml  text eol=lf

# 二进制
*.png binary
*.jpg binary
*.zip binary
